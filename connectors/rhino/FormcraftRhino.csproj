<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Formcraft in Rhino 8 (the engineering hub, step H1): a local bridge the MCP server's fmc_rhino talks to. It builds
    named closed solids (family parts) in its own memory, never in the person's open drawing, and writes them with
    openNURBS, so the tools work whatever Rhino's licence state, as long as Rhino opens.
    Built against the installed Rhino 8 (RhinoCommon and Rhino's own Newtonsoft.Json are never copied). It isn't in the
    solution, so CI doesn't need Rhino. Installed per user, no admin rights, as a Rhino package:
      %APPDATA%\McNeel\Rhinoceros\packages\8.0\Formcraft.Rhino\1.0.0\Formcraft.Rhino.rhp
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Formcraft.Rhino</AssemblyName>
    <RootNamespace>Formcraft.Rhino</RootNamespace>
    <TargetExt>.rhp</TargetExt>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RhinoDir Condition="'$(RhinoDir)' == ''">C:\Program Files\Rhino 8\System</RhinoDir>
    <OutDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\Formcraft.Rhino\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(RhinoDir)\RhinoCommon.dll')">
    <Reference Include="RhinoCommon"><HintPath>$(RhinoDir)\RhinoCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(RhinoDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <None Include="manifest.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="NoRhino" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(RhinoDir)\RhinoCommon.dll')">
    <Error Text="Rhino 8 isn't at $(RhinoDir): build this on a PC with Rhino 8, or pass -p:RhinoDir=..." />
  </Target>
</Project>
