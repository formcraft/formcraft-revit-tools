{
  "schema": "fmc-testrun/0.1",
  "id": "06_room_icu_families",
  "title": "The sample tree's whole ICU bay (door, observation window, bed, operating light) built in a scratch project",
  "features": ["F72", "F70"],
  "setup": [
    {
      "id": "new",
      "tool": "fmc_file",
      "args": { "action": "create_from_template", "kind": "project", "template_path": "{{project_template}}", "save_path": "{{scratch}}\\FMC_ChainTest_A.rvt", "close_after": true, "dry_run": false },
      "checks": [{ "no_error": true }, { "path": "done", "equals": true }]
    },
    { "id": "open", "runner": "open_in_revit", "path": "{{scratch}}\\FMC_ChainTest_A.rvt" },
    { "id": "levels", "note": "The scratch project's levels (the kit template names them): the room goes on the lowest", "revit": "fmc_document_info", "params": {},
      "checks": [{ "path": "active.levels", "at_least": 1 }] }
  ],
  "steps": [
    {
      "id": "plan",
      "tool": "fmc_room",
      "args": {
        "action": "plan",
        "room": {
          "name": "ICU bay", "number": "L2-ICU-01", "level": "{{steps.levels.active.levels.0.name}}", "origin_mm": [0, 0], "width": 4200, "depth": 5000, "height": 3300,
          "walls": { "type": "Generic - 200mm", "thickness": 200 }, "ceiling": { "type": "Generic", "height": 2900 },
          "openings": [
            { "kind": "door", "family": "FMC_A_Door_FlushSingle_Hygienic_Detailed", "type": "1026x2100_S", "wall": "south", "along": 900, "width": 1026 },
            { "kind": "window", "family": "FMC_A_Window_Observation_Internal_Nurse_Detailed", "type": "1200x900_WfixedSWoption", "wall": "south", "along": 2800, "width": 1200, "sill": 900 }
          ],
          "items": [
            { "id": "Bed", "family": "FMC_I_MedEq_Bed_ICU_Electric_Detailed", "type": "1020x2200_Standard", "at": { "wall": "north", "off": 150 }, "size": [1020, 2200], "clearance": 1200 },
            { "id": "Operating light", "family": "FMC_E_LightFixture_OperatingLight_Ceiling_Detailed", "type": "700_Single", "at": { "centre": true, "dy": 600 }, "host": "ceiling" }
          ]
        }
      },
      "checks": [{ "no_error": true }, { "path": "problems", "at_most": 0 }]
    },
    {
      "id": "build",
      "note": "The families must be in the scratch project: a finding here that one isn't loaded is real (no tool loads staged families into a project yet)",
      "tool": "fmc_room",
      "args": {
        "action": "build", "node": "ICU-Bay-01.Room", "project_folder": "{{scratch}}", "dry_run": false,
        "room": {
          "name": "ICU bay", "number": "L2-ICU-01", "level": "{{steps.levels.active.levels.0.name}}", "origin_mm": [0, 0], "width": 4200, "depth": 5000, "height": 3300,
          "walls": { "type": "Generic - 200mm", "thickness": 200 }, "ceiling": { "type": "Generic", "height": 2900 },
          "openings": [
            { "kind": "door", "family": "FMC_A_Door_FlushSingle_Hygienic_Detailed", "type": "1026x2100_S", "wall": "south", "along": 900, "width": 1026 },
            { "kind": "window", "family": "FMC_A_Window_Observation_Internal_Nurse_Detailed", "type": "1200x900_WfixedSWoption", "wall": "south", "along": 2800, "width": 1200, "sill": 900 }
          ],
          "items": [
            { "id": "Bed", "family": "FMC_I_MedEq_Bed_ICU_Electric_Detailed", "type": "1020x2200_Standard", "at": { "wall": "north", "off": 150 }, "size": [1020, 2200], "clearance": 1200 },
            { "id": "Operating light", "family": "FMC_E_LightFixture_OperatingLight_Ceiling_Detailed", "type": "700_Single", "at": { "centre": true, "dy": 600 }, "host": "ceiling" }
          ]
        }
      },
      "timeout_s": 900,
      "checks": [{ "no_error": true }, { "path": "made", "at_least": 10 }, { "path": "notes", "at_most": 0 }]
    }
  ],
  "teardown": [{ "runner": "close_revit" }]
}
