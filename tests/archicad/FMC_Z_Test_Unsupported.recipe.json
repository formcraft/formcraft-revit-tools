{
  "schema": "fmc-recipe/0.1",
  "family": "FMC_Z_Test_Unsupported",
  "template": "Metric Generic Model.rft",
  "about": "fmc_archicad fixture: features GDL export can't carry, so the dry run must name each one with a reason.",
  "ops": [
    { "op": "set_category", "name": "Generic Models" },
    { "op": "add_family_param", "name": "Body Width", "type": "Length" },
    { "op": "add_family_param", "name": "Handle Type", "type": "FamilyType", "instance": false },
    { "op": "add_family_param", "name": "Product Image", "type": "Image", "instance": false },
    { "op": "add_family_param", "name": "Is Wide", "type": "YesNo", "instance": false },
    { "op": "add_family_param", "name": "Load", "type": "ApparentPower", "instance": false },
    { "op": "add_family_param", "name": "Spin", "type": "Gizmo", "instance": false },
    { "op": "set_formula", "name": "Is Wide", "formula": "if(Body Width > 500 mm, 1 = 1, 1 = 0)" },
    { "op": "add_type", "name": "Standard" },
    { "op": "set_type_value", "name": "Standard/Body Width", "type": "Standard", "param": "Body Width", "value": 400 },
    { "op": "set_type_value", "name": "Standard/Load", "type": "Standard", "param": "Load", "value": 1200 },
    { "op": "add_ref_plane", "name": "Body Left", "from": [-200, -300], "to": [-200, 300] },
    { "op": "add_ref_plane", "name": "Body Right", "from": [200, -300], "to": [200, 300] },
    { "op": "add_ref_plane", "name": "Body Front", "from": [-300, -150], "to": [300, -150] },
    { "op": "add_ref_plane", "name": "Body Back", "from": [-300, 150], "to": [300, 150] },
    { "op": "extrusion", "name": "Body", "rect": ["Body Left", "Body Right", "Body Front", "Body Back"], "start": 0, "end": 600 },
    { "op": "extrusion", "name": "Sill Box", "rect": ["Body Left", "Body Right", "Body Front", "Sill"], "start": 0, "end": 50 },
    { "op": "extrusion", "name": "Arc Plate", "points": [{ "arc": [[0, 0], [50, 50], [100, 0]] }, [100, -20], [0, -20]], "start": 600, "end": 610 },
    { "op": "blend", "name": "Taper Odd", "base": [[-100, -100], [100, -100], [100, 100], [-100, 100]], "top": [[0, -50], [50, 50], [-50, 50]], "start": 600, "end": 800 },
    { "op": "blend", "name": "Taper Even", "base": [[-100, -100], [100, -100], [100, 100], [-100, 100]], "top": [[-50, -50], [50, -50], [50, 50], [-50, 50]], "start": 600, "end": 700 },
    { "op": "revolution", "name": "Half Knob", "profile": [[0, 600], [30, 600], [30, 640], [0, 640]], "axis_at": [0, 0], "start_deg": 0, "end_deg": 180 },
    { "op": "sweep", "name": "Profiled Trim", "path_plane": "front", "path_planes": [["Body Left", "Ref. Level"], ["Body Left", "Head"]], "profile_family": "FMC_Profile_Architrave_Greek", "profile_type": "70x15" },
    { "op": "sweep", "name": "Trim To Template Plane", "path_plane": "front", "profile": [[-10, -10], [10, -10], [10, 10], [-10, 10]], "path_planes": [["Left", "Ref. Level"], ["Left", "Head"]] },
    { "op": "swept_blend", "name": "Spout", "path": [[0, 0], [0, 100]], "profile": [[0, 0], [1, 1]] },
    { "op": "load_family", "name": "FMC_P_PlumbingEq_ServicePoint_Water", "path": "P\\FMC_P_PlumbingEq_ServicePoint_Water.rfa", "shared": true },
    { "op": "place_nested", "name": "Water Point", "family": "FMC_P_PlumbingEq_ServicePoint_Water", "type": "60_Water", "at": [0, 150, 300] },
    { "op": "add_connector", "name": "Power", "domain": "electrical", "system": "PowerBalanced", "solid": "Body", "side": "back" },
    { "op": "add_connector", "name": "Ghost", "domain": "piping", "solid": "No Such Solid", "side": "top" },
    { "op": "symbolic_lines", "name": "Front opening", "view": "front", "points": [[-200, 0], [200, 600]] },
    { "op": "symbolic_lines", "name": "Swing on planes", "view": "plan", "points": [["Body Left", "Body Front"], ["Body Right", "Body Back"]] },
    { "op": "void_extrusion", "name": "Lonely Void", "points": [[1000, 1000], [1100, 1000], [1100, 1100], [1000, 1100]], "start": 0, "end": 10 }
  ]
}
