<Project Sdk="Microsoft.NET.Sdk">
    <!-- Path-safety tests for FmcCentralPaths (no Revit). Exit 0 when IsSafeTempPath
         refuses the temp root itself and accepts only a local strict subfolder. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>CentralTempSafety</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\..\..\commandset\Services\Fmc\FmcCentralPaths.cs" Link="FmcCentralPaths.cs" />
    </ItemGroup>
</Project>
