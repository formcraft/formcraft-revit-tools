<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TouchKit.Core - pure C# logic with NO Revit or Windows UI references.
    Everything here can be unit tested without Revit running.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TouchKit.Core</RootNamespace>
    <AssemblyName>TouchKit.Core</AssemblyName>
    <Version>0.3.0</Version>
    <Company>Formcraft</Company>
    <Product>Formcraft Flow · touch</Product>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TouchKit.Core.Tests" />
  </ItemGroup>

</Project>
