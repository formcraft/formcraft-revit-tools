<UserControl x:Class="Formcraft.Shell.Preview.DocumentBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Preview only: stands in for the document open in Revit and the Formcraft service -->
  <WrapPanel VerticalAlignment="Center">
    <TextBlock Text="Document" Style="{DynamicResource FmcText.Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <ListBox Style="{DynamicResource FmcSegmented}" ItemsSource="{Binding Documents}" DisplayMemberPath="Label"
             SelectedValuePath="Value" SelectedValue="{Binding OpenDocument}" AutomationProperties.Name="Document" Margin="0,0,14,0"/>
    <TextBlock Text="Service" Style="{DynamicResource FmcText.Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <ListBox Style="{DynamicResource FmcSegmented}" ItemsSource="{Binding Connections}" DisplayMemberPath="Label"
             SelectedValuePath="Value" SelectedValue="{Binding ConnectionState}" AutomationProperties.Name="Service" Margin="0,0,14,0"/>
    <TextBlock Text="State" Style="{DynamicResource FmcText.Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <ComboBox Style="{DynamicResource FmcComboBox}" ItemsSource="{Binding States}" SelectedItem="{Binding PaneState}" MinWidth="130"
              AutomationProperties.Name="State (board account/PaneStates)"/>
  </WrapPanel>
</UserControl>
