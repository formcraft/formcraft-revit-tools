<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the Formcraft pane shell on its own, on mock services, without Revit. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Formcraft.Shell\Formcraft.Shell.csproj"/>
  </ItemGroup>

</Project>
