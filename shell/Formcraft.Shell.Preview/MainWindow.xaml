<Window x:Class="Formcraft.Shell.Preview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Formcraft.Shell.Views;assembly=Formcraft.Shell"
        xmlns:local="clr-namespace:Formcraft.Shell.Preview"
        Title="Formcraft pane · shell preview (mock data)" Width="460" Height="880" MinWidth="340"
        Background="{DynamicResource Fmc.BackdropBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Theme/FmcColors.Light.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Theme/FmcTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel>
    <!-- Preview tools: not part of the pane -->
    <DockPanel DockPanel.Dock="Top" Margin="8,8,8,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="Log file" Style="{StaticResource FmcButton.Secondary}" Click="OnOpenLog" Margin="0,0,6,0" ToolTip="Core › Log file on the ribbon (U10)"/>
        <Button Content="Kit gallery" Style="{StaticResource FmcButton.Secondary}" Click="OnOpenGallery"/>
      </StackPanel>
      <StackPanel>
        <local:ThemeBar x:Name="Themes"/>
        <local:DocumentBar x:Name="Documents" Margin="0,6,0,0"/>
      </StackPanel>
    </DockPanel>
    <Border Margin="8" BorderBrush="{DynamicResource Fmc.LineBrush}" BorderThickness="1" Background="{DynamicResource Fmc.SurfaceBrush}">
      <views:ShellView x:Name="Shell"/>
    </Border>
  </DockPanel>
</Window>
