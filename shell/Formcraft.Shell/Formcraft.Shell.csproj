<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Formcraft pane shell: theme, frame, navigation, sign-in, licence and states.
    No Revit reference on purpose. It runs on mock services in Formcraft.Shell.Preview,
    and the add-in hosts the same views in a dockable pane (net48 for Revit 2020-2024, net8 for 2025+).
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Formcraft.Shell</RootNamespace>
    <AssemblyName>Formcraft.Shell</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The one product version the pane shows (Settings › General › Version, Settings › Updates › Installed) -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- IBM Plex, embedded so the pane looks the same on every PC (licence: resources/fonts/OFL.txt) -->
  <ItemGroup>
    <Resource Include="..\..\resources\fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)"/>
  </ItemGroup>

  <!-- The pane's groups, sections and parts (UI configuration, not kit data) -->
  <ItemGroup>
    <EmbeddedResource Include="Services\sections.json" LogicalName="Formcraft.Shell.sections.json"/>
  </ItemGroup>

  <!-- The engineering grid (E0): 23 systems by 7 capabilities, the one file the pane, the tracker and the server read -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\tracker\mep_matrix.json" Link="Data\mep_matrix.json" LogicalName="Formcraft.Shell.mep_matrix.json"/>
  </ItemGroup>

</Project>
