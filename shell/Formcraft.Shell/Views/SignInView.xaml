<!--
  Sign in (board account/PaneSignIn): email and password, Microsoft or Google through the browser, two-step code in a
  dialog; an offline licence file for PCs with no internet; what signing in does. DataContext: SignInViewModel.
  Loads before it joins the pane, so theme styles are DynamicResource.
-->
<UserControl x:Class="Formcraft.Shell.Views.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Formcraft.Shell.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
    <StackPanel>
      <Border Style="{DynamicResource FmcGroup}">
        <StackPanel>
          <TextBlock Text="SIGN IN TO FORMCRAFT" Style="{DynamicResource FmcText.Section}"/>
          <TextBlock Text="{Binding Message}" Style="{DynamicResource FmcText.Hint}" Margin="0,0,0,10"/>
          <TextBlock Text="Work email" Style="{DynamicResource FmcText.Label}"/>
          <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource FmcTextBox}" Margin="0,0,0,8"
                   AutomationProperties.Name="Work email" c:Fmc.Placeholder="name@company.com"/>
          <TextBlock Text="Password" Style="{DynamicResource FmcText.Label}"/>
          <PasswordBox x:Name="PasswordInput" Style="{DynamicResource FmcPasswordBox}" Margin="0,0,0,8" PasswordChanged="OnPasswordChanged"
                       AutomationProperties.Name="Password"/>
          <CheckBox Content="Keep me signed in on this PC" IsChecked="{Binding KeepSignedIn}" Style="{DynamicResource FmcToggle}" Margin="0,0,0,10"/>
          <WrapPanel>
            <Button Content="Sign in" Style="{DynamicResource FmcButton.Primary}" Command="{Binding SignInCommand}" IsDefault="True" Margin="0,0,6,6"/>
            <Button Content="Sign in with Microsoft" Style="{DynamicResource FmcButton.Secondary}" Command="{Binding MicrosoftCommand}" Margin="0,0,6,6"/>
            <Button Content="Sign in with Google" Style="{DynamicResource FmcButton.Secondary}" Command="{Binding GoogleCommand}" Margin="0,0,6,6"/>
          </WrapPanel>
          <WrapPanel>
            <Button Content="Forgot password" Style="{DynamicResource FmcButton.Link}" Command="{Binding ForgotPasswordCommand}" Margin="0,0,14,0"/>
            <Button Content="No account? Ask your admin" Style="{DynamicResource FmcButton.Link}" Command="{Binding AskAdminCommand}"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource FmcGroup}">
        <StackPanel>
          <TextBlock Text="NO INTERNET ON THIS PC" Style="{DynamicResource FmcText.Section}"/>
          <TextBlock Text="Ask your admin for an offline licence file. It works for 30 days, then needs a check-in." Style="{DynamicResource FmcText.Hint}" Margin="0,0,0,8"/>
          <TextBlock Text="Offline licence file" Style="{DynamicResource FmcText.Label}"/>
          <Grid x:Name="DropZone" AllowDrop="True" Drop="OnLicenceDrop" DragOver="OnLicenceDragOver" MinHeight="56" Background="Transparent"
                AutomationProperties.Name="Offline licence file">
            <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="1.2" StrokeDashArray="4 3" Stroke="{DynamicResource Fmc.LineBrush}"/>
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
              <TextBlock Text="Drop FMC_Licence_&lt;PC&gt;.lic here" FontSize="11.5" Foreground="{DynamicResource Fmc.MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Button Content="Choose file…" Style="{DynamicResource FmcButton.Secondary}" Click="OnChooseLicence"/>
            </WrapPanel>
          </Grid>
          <TextBlock Text="Made by your admin in Admin › Licences and seats" Style="{DynamicResource FmcText.Hint}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource FmcGroup}" BorderThickness="0">
        <StackPanel>
          <TextBlock Text="WHAT SIGNING IN DOES" Style="{DynamicResource FmcText.Section}"/>
          <ItemsControl ItemsSource="{Binding WhatItDoes}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <c:FmcCheckRow Content="{Binding}" IsChecked="True" IsHitTestVisible="False" Focusable="False"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
