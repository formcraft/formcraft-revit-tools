<!--
  Settings (boards account/PaneAccount, core/PaneSettings, */PaneSettings*): the tab switcher, then the Account tab or the
  open tab's groups. Each kind of setting has one template below, so every tab looks and saves the same way.
  DataContext: ShellViewModel. Loads before it joins the pane, so theme styles are DynamicResource.
-->
<UserControl x:Class="Formcraft.Shell.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Formcraft.Shell.Controls"
             xmlns:vm="clr-namespace:Formcraft.Shell.ViewModels">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Views/SettingTemplates.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
    <StackPanel>
      <!-- Tab switcher -->
      <Border Style="{DynamicResource FmcGroup}" DataContext="{Binding Settings}">
        <StackPanel>
          <TextBlock Text="SETTINGS SECTIONS" Style="{DynamicResource FmcText.Section}"/>
          <TextBlock Text="Show" Style="{DynamicResource FmcText.Label}"/>
          <ListBox Style="{DynamicResource FmcSegmented}" ItemsSource="{Binding TabNames}" SelectedItem="{Binding CurrentName}"
                   AutomationProperties.Name="Settings sections" HorizontalAlignment="Stretch">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
          <TextBlock Text="{Binding TabHint}" Style="{DynamicResource FmcText.Hint}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <!-- Account (board account/PaneAccount) -->
      <StackPanel DataContext="{Binding Account}"
                  Visibility="{Binding DataContext.Settings.IsAccount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}">
        <Border Style="{DynamicResource FmcGroup}">
          <StackPanel>
            <TextBlock Text="YOU" Style="{DynamicResource FmcText.Section}"/>
            <TextBlock Text="Name and email" Style="{DynamicResource FmcText.Label}"/>
            <TextBox Text="{Binding Who, Mode=OneWay}" Style="{DynamicResource FmcReadOnly}" FontFamily="{DynamicResource Fmc.Font}" FontSize="12" Margin="0,0,0,8"/>
            <TextBlock Text="Organisation" Style="{DynamicResource FmcText.Label}"/>
            <TextBox Text="{Binding Organisation, Mode=OneWay}" Style="{DynamicResource FmcReadOnly}" FontFamily="{DynamicResource Fmc.Font}" FontSize="12" Margin="0,0,0,8"/>
            <TextBlock Text="Role" Style="{DynamicResource FmcText.Label}"/>
            <TextBox Text="{Binding Role, Mode=OneWay}" Style="{DynamicResource FmcReadOnly}" FontFamily="{DynamicResource Fmc.Font}" FontSize="12"/>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource FmcGroup}">
          <StackPanel>
            <TextBlock Text="YOUR MODULES" Style="{DynamicResource FmcText.Section}"/>
            <Border BorderBrush="{DynamicResource Fmc.DividerBrush}" BorderThickness="1" CornerRadius="4">
              <StackPanel>
                <Grid Background="{DynamicResource Fmc.HeaderBrush}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="MODULE" FontSize="10.5" Foreground="{DynamicResource Fmc.MutedBrush}" Margin="8,5"/>
                  <TextBlock Grid.Column="1" Text="STATUS" FontSize="10.5" Foreground="{DynamicResource Fmc.MutedBrush}" Margin="8,5"/>
                  <TextBlock Grid.Column="2" Text="UNTIL" FontSize="10.5" Foreground="{DynamicResource Fmc.MutedBrush}" Margin="8,5" Width="92"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Modules}" Focusable="False" AutomationProperties.Name="Your modules">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource Fmc.DividerBrush}" BorderThickness="0,1,0,0">
                        <Grid MinHeight="30">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
                          <ContentControl Grid.Column="1" Content="{Binding Status}" FontSize="10.5" Margin="6,0"
                                          c:Fmc.StyleKey="{Binding Kind, StringFormat=FmcChip.{0}}"/>
                          <TextBlock Grid.Column="2" Text="{Binding Until}" FontSize="11.5" Foreground="{DynamicResource Fmc.MutedBrush}" VerticalAlignment="Center" Margin="8,0" Width="92"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <WrapPanel Margin="0,8,0,0">
              <ItemsControl ItemsSource="{Binding Modules}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding RequestText}" Style="{DynamicResource FmcButton.Secondary}" Margin="0,0,6,6"
                            Visibility="{Binding CanRequest, Converter={StaticResource Vis}}"
                            Command="{Binding DataContext.Account.RequestModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Enter a licence key" Style="{DynamicResource FmcButton.Secondary}" Command="{Binding EnterKeyCommand}" Margin="0,0,6,6"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource FmcGroup}">
          <StackPanel>
            <TextBlock Text="THIS PC" Style="{DynamicResource FmcText.Section}"/>
            <TextBlock Text="Seat" Style="{DynamicResource FmcText.Label}"/>
            <TextBox Text="{Binding Seat, Mode=OneWay}" Style="{DynamicResource FmcReadOnly}" Margin="0,0,0,8"/>
            <TextBlock Text="Licence check" Style="{DynamicResource FmcText.Label}"/>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,4,0">
                <TextBlock Text="Last checked online" Style="{DynamicResource FmcText.Hint}"/>
                <TextBox Text="{Binding LastChecked, Mode=OneWay}" Style="{DynamicResource FmcReadOnly}" FontFamily="{DynamicResource Fmc.Font}" FontSize="12"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Text="Works offline for" Style="{DynamicResource FmcText.Hint}"/>
                <TextBox Text="{Binding WorksOfflineFor, Mode=OneWay}" Style="{DynamicResource FmcReadOnly}" FontFamily="{DynamicResource Fmc.Font}" FontSize="12"/>
              </StackPanel>
            </Grid>
            <WrapPanel>
              <Button Content="Check now" Style="{DynamicResource FmcButton.Secondary}" Command="{Binding CheckNowCommand}" Margin="0,0,6,6"/>
              <Button Content="Release this seat" Style="{DynamicResource FmcButton.Secondary}" Command="{Binding ReleaseSeatCommand}" Margin="0,0,6,6"/>
              <Button Content="Sign out" Style="{DynamicResource FmcButton.Secondary}" Command="{Binding SignOutCommand}" Margin="0,0,6,6"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource FmcGroup}" BorderThickness="0">
          <StackPanel>
            <TextBlock Text="ASK AI IN THE PANE" Style="{DynamicResource FmcText.Section}"/>
            <TextBlock Text="Key" Style="{DynamicResource FmcText.Label}"/>
            <TextBox Text="{Binding ClaudeKey, Mode=OneWay}" Style="{DynamicResource FmcReadOnly}" FontFamily="{DynamicResource Fmc.Font}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBlock Text="Today on this PC" Style="{DynamicResource FmcText.Label}"/>
            <TextBox Text="{Binding ClaudeToday, Mode=OneWay}" Style="{DynamicResource FmcReadOnly}" FontFamily="{DynamicResource Fmc.Font}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="Buying, renewals and invoices are on the Formcraft account website, never in Revit." Style="{DynamicResource FmcText.Hint}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Every other tab: its groups -->
      <ItemsControl ItemsSource="{Binding Settings.Current.Groups}" Focusable="False"
                    Visibility="{Binding Settings.IsGroups, Converter={StaticResource Vis}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource FmcGroup}">
              <StackPanel>
                <TextBlock Text="{Binding Title, Converter={StaticResource Upper}}" Style="{DynamicResource FmcText.Section}"/>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
