<!--
  Build workspace window (board build/B_Workspace): BOQ, packages and progress at full size, beside the model or on a
  second monitor. The rows are drawn with the pane's own templates. DataContext: BuildWorkspacePage.
-->
<Window x:Class="Formcraft.Shell.Views.BuildWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Formcraft.Shell.Views"
        Title="Formcraft Build · workspace" Width="1100" Height="720" MinWidth="640" MinHeight="400"
        Background="{DynamicResource Fmc.SurfaceBrush}" FontFamily="{DynamicResource Fmc.Font}" FontSize="12.5">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Theme/FmcColors.Light.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Theme/FmcTheme.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Views/SettingTemplates.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Fmc.HeaderBrush}" Padding="12,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Second monitor" Style="{StaticResource FmcButton.Secondary}" Click="OnSecondMonitor"
                ToolTip="Moves the workspace to the next monitor and fills it"/>
        <TextBlock Text="Formcraft Build · workspace" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Height="2" Background="{DynamicResource Fmc.OrangeBrush}"/>
    <TextBlock DockPanel.Dock="Bottom" Margin="12,6" Style="{StaticResource FmcText.Hint}"
               Text="Quantities from the model and the kit's codes. Rates are the QS's and never show in Revit. Nothing here changes the model."/>
    <v:SectionPageView/>
  </DockPanel>
</Window>
