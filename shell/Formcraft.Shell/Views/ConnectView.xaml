<!--
  Connect (board core/PaneConnect): health, kit and rules, folders, chat through MCP, the AI buttons to come, safety and
  support, in the same groups and rows as Settings. DataContext: ConnectViewModel. Theme styles are DynamicResource.
-->
<UserControl x:Class="Formcraft.Shell.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Views/SettingTemplates.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Connect" Style="{DynamicResource FmcText.GroupTitle}" Margin="10,10,10,0"/>
      <TextBlock Text="Health, kit, folders and safety in one place, working offline." Style="{DynamicResource FmcText.Hint}" Margin="10,0,10,4"/>
      <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource FmcGroup}">
              <StackPanel>
                <TextBlock Text="{Binding Title, Converter={StaticResource Upper}}" Style="{DynamicResource FmcText.Section}"/>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
