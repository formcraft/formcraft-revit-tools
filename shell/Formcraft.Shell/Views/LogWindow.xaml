<!--
  Log file window (board core/UI_Log): filters, the file line, the table (Time, From, Tool, Document, Kind, Result) and
  Open the CSV / Open the reports folder / Copy row for support. A window of its own, themed like the pane.
  DataContext: LogViewModel.
-->
<Window x:Class="Formcraft.Shell.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formcraft · Log file" Width="860" Height="520" MinWidth="560" MinHeight="320"
        Background="{DynamicResource Fmc.SurfaceBrush}" FontFamily="{DynamicResource Fmc.Font}" FontSize="12.5">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Theme/FmcColors.Light.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Theme/FmcTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="Vis"/>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Fmc.HeaderBrush}" Padding="12,8">
      <DockPanel>
        <CheckBox DockPanel.Dock="Right" Content="Today only" IsChecked="{Binding OnlyToday}" Style="{StaticResource FmcToggle}" VerticalAlignment="Center"/>
        <ListBox Style="{StaticResource FmcSegmented}" ItemsSource="{Binding FilterNames}" SelectedItem="{Binding Filter}" AutomationProperties.Name="Show"/>
        <TextBlock Text="{Binding FileLine}" Style="{StaticResource FmcText.Hint}" FontFamily="{StaticResource Fmc.Mono}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Height="2" Background="{DynamicResource Fmc.OrangeBrush}"/>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Fmc.FooterBrush}" BorderBrush="{DynamicResource Fmc.DividerBrush}" BorderThickness="0,1,0,0" Padding="12,7">
      <DockPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="Open the CSV" Style="{StaticResource FmcButton.Secondary}" Command="{Binding OpenCsvCommand}" Margin="0,0,6,0"/>
          <Button Content="Open the reports folder" Style="{StaticResource FmcButton.Secondary}" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0"/>
          <Button Content="Copy row for support" Style="{StaticResource FmcButton.Secondary}" Command="{Binding CopyRowCommand}" Margin="0,0,6,0"/>
          <Button Content="Refresh" Style="{StaticResource FmcButton.Secondary}" Command="{Binding RefreshCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding Message}" Style="{StaticResource FmcText.Hint}" FontSize="11.5" VerticalAlignment="Center" TextAlignment="Right" Margin="12,0,0,0"
                   AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Margin="12,6" Style="{StaticResource FmcText.Hint}"
               Text="Refusals are logged too. The log records tools and results for support and audit; it is never used to rank people (Manual 14.5). Ask Claude rows hold tokens only."/>

    <Grid Margin="12,10,12,0">
      <DataGrid Style="{StaticResource FmcTable}" ScrollViewer.PanningMode="Both" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Log rows"
                VerticalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="58"/>
          <DataGridTextColumn Header="From" Binding="{Binding From}" Width="66"/>
          <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="1.2*"/>
          <DataGridTextColumn Header="Document" Binding="{Binding Document}" Width="1.6*"/>
          <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="72"/>
          <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding EmptyText}" Style="{StaticResource FmcText.Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
    </Grid>
  </DockPanel>
</Window>
