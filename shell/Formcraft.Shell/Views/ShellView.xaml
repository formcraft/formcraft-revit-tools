<UserControl x:Class="Formcraft.Shell.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MaxWidth="560"
             FontFamily="{DynamicResource Fmc.Font}" FontSize="12.5"
             Background="{DynamicResource Fmc.SurfaceBrush}" Foreground="{DynamicResource Fmc.InkBrush}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Theme/FmcColors.Light.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Theme/FmcTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="Vis"/>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel LastChildFill="True">

    <!-- Header: name, connection state, Settings, Help -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Fmc.HeaderBrush}" Height="34" Padding="10,0">
      <DockPanel VerticalAlignment="Center">
        <TextBlock Text="Formcraft" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
        <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="11" Background="{DynamicResource Fmc.Chip.GreyBg}" VerticalAlignment="Center">
          <TextBlock Text="{Binding HeaderStatus}" FontSize="11" Foreground="{DynamicResource Fmc.Chip.GreyFg}"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Settings" Style="{StaticResource FmcButton.Secondary}" Command="{Binding OpenSettingsCommand}"
                  Visibility="{Binding IsMain, Converter={StaticResource Vis}}" Margin="0,0,6,0"/>
          <Button Content="?" Style="{StaticResource FmcButton.Secondary}" ToolTip="Help and the first-run tour" AutomationProperties.Name="Help"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Height="2" Background="{DynamicResource Fmc.OrangeBrush}"/>

    <!-- Footer: status line -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Fmc.FooterBrush}" BorderBrush="{DynamicResource Fmc.DividerBrush}" BorderThickness="0,1,0,0" Padding="8,5">
      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Fmc.MutedBrush}" TextTrimming="CharacterEllipsis"/>
    </Border>

    <Grid>

      <!-- 1. Sign in -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DataContext.IsSignIn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}" DataContext="{Binding SignIn}">
        <StackPanel Margin="10">
          <TextBlock Text="Sign in to Formcraft" Style="{StaticResource FmcText.GroupTitle}"/>
          <TextBlock Text="{Binding Message}" Style="{StaticResource FmcText.Hint}" Margin="0,0,0,8"/>
          <TextBlock Text="Work email" Style="{StaticResource FmcText.Hint}"/>
          <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FmcTextBox}" Margin="0,2,0,6" AutomationProperties.Name="Work email"/>
          <TextBlock Text="Password" Style="{StaticResource FmcText.Hint}"/>
          <PasswordBox x:Name="PasswordInput" Style="{StaticResource FmcPasswordBox}" Margin="0,2,0,8" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Password"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="Sign in" Style="{StaticResource FmcButton.Primary}" Command="{Binding SignInCommand}" IsDefault="True" Margin="0,0,6,0"/>
            <Button Content="Sign in with Microsoft" Style="{StaticResource FmcButton.Secondary}" Margin="0,0,6,0"/>
            <Button Content="Work offline" Style="{StaticResource FmcButton.Secondary}" Command="{Binding WorkOfflineCommand}"/>
          </StackPanel>
          <StackPanel Visibility="{Binding NeedsCode, Converter={StaticResource Vis}}" Margin="0,12,0,0">
            <TextBlock Text="6-digit code" Style="{StaticResource FmcText.Hint}"/>
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FmcTextBox}" FontFamily="{StaticResource Fmc.Mono}" Margin="0,2,0,6" AutomationProperties.Name="Code"/>
            <Button Content="Verify" Style="{StaticResource FmcButton.Primary}" Command="{Binding VerifyCommand}" HorizontalAlignment="Left"/>
          </StackPanel>
          <TextBlock Text="Signing in checks your seat and modules. It never reads or sends model content." Style="{StaticResource FmcText.Hint}" Margin="0,14,0,0"/>
        </StackPanel>
      </ScrollViewer>

      <!-- 2. First-run setup -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DataContext.IsWelcome, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}" DataContext="{Binding Welcome}">
        <StackPanel Margin="10">
          <TextBlock Text="Set up this PC" Style="{StaticResource FmcText.GroupTitle}"/>
          <TextBlock Text="Formcraft kit folder" Style="{StaticResource FmcText.Hint}"/>
          <TextBox Text="{Binding KitFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FmcTextBox}" FontFamily="{StaticResource Fmc.Mono}" Margin="0,2,0,6"/>
          <TextBlock Text="Your BIM Manager gives you this path. Role, disciplines and the parts to show come next (see the First-run setup board)." Style="{StaticResource FmcText.Hint}" Margin="0,0,0,8"/>
          <Button Content="Continue" Style="{StaticResource FmcButton.Primary}" Command="{Binding ContinueCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>

      <!-- 3. Main pane -->
      <DockPanel Visibility="{Binding IsMain, Converter={StaticResource Vis}}">

        <TextBox DockPanel.Dock="Top" Margin="10,6,10,0" Style="{StaticResource FmcTextBox}"
                 Text="" ToolTip="Find a feature or rule… (Ctrl+K)" AutomationProperties.Name="Find a feature"/>

        <!-- Groups -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Fmc.DividerBrush}" BorderThickness="0,0,0,1" Margin="10,2,10,0">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource FmcNav.Group}" GroupName="FmcGroups" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                             Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Sections of the current group -->
        <ItemsControl DockPanel.Dock="Top" Margin="10,6" ItemsSource="{Binding CurrentGroup.Sections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Style="{StaticResource FmcNav.Section}" GroupName="FmcSections" IsChecked="{Binding IsSelected, Mode=OneWay}"
                           Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}"/>
                  <TextBlock Text="{Binding ModuleTag}" FontSize="9.5" Margin="5,0,0,0" Opacity="0.8"/>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Document banner: which model, and what the live-model lock allows -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Fmc.DividerBrush}" BorderThickness="0,1" Padding="10,6,10,8">
          <Border Background="{DynamicResource Fmc.Chip.GoodBg}" CornerRadius="5" Padding="8,6">
            <StackPanel>
              <TextBlock Text="{Binding DocumentTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Fmc.Chip.GoodFg}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding DocumentLock}" FontSize="11" Foreground="{DynamicResource Fmc.Chip.GoodFg}"/>
            </StackPanel>
          </Border>
        </Border>

        <Grid>
          <!-- Section body: locked state or placeholder until the feature is built -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DataContext.ShowSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}" DataContext="{Binding Body}">
            <StackPanel Margin="10">
              <TextBlock Text="{Binding Title}" Style="{StaticResource FmcText.GroupTitle}"/>
              <Border Visibility="{Binding Locked, Converter={StaticResource Vis}}" Background="{DynamicResource Fmc.Chip.WarnBg}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="{Binding LockedText}" Foreground="{DynamicResource Fmc.Chip.WarnFg}" FontWeight="SemiBold"/>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Start a 14-day trial" Style="{StaticResource FmcButton.Primary}" Margin="0,0,6,0"/>
                    <Button Content="Ask your admin" Style="{StaticResource FmcButton.Secondary}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding PlaceholderText}" Style="{StaticResource FmcText.Hint}"/>
            </StackPanel>
          </ScrollViewer>

          <!-- Settings › Account -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DataContext.SettingsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}" DataContext="{Binding Account}">
            <StackPanel Margin="10">
              <TextBlock Text="Settings › Account" Style="{StaticResource FmcText.GroupTitle}"/>
              <TextBlock Text="{Binding Who}" Style="{StaticResource FmcText.Body}"/>
              <TextBlock Text="{Binding Organisation}" Style="{StaticResource FmcText.Hint}"/>
              <TextBlock Text="{Binding Role}" Style="{StaticResource FmcText.Hint}" Margin="0,0,0,10"/>
              <TextBlock Text="Your modules" Style="{StaticResource FmcText.GroupTitle}"/>
              <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="100"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Status}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Until}" Foreground="{DynamicResource Fmc.MutedBrush}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding OfflineText}" Style="{StaticResource FmcText.Hint}" Margin="0,10,0,6"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="Check now" Style="{StaticResource FmcButton.Secondary}" Command="{Binding CheckNowCommand}" Margin="0,0,6,0"/>
                <Button Content="Release this seat" Style="{StaticResource FmcButton.Secondary}" Command="{Binding ReleaseSeatCommand}" Margin="0,0,6,0"/>
                <Button Content="Sign out" Style="{StaticResource FmcButton.Secondary}" Command="{Binding SignOutCommand}"/>
              </StackPanel>
              <TextBlock Text="Buying, renewals and invoices are on the Formcraft account website, never in Revit." Style="{StaticResource FmcText.Hint}" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
