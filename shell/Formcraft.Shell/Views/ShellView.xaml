<!--
  The pane (boards: every pane board's frame in design/generators/gen_panes.py pane(), core/PaneShell,
  core/ResponsivePane). Header, orange line, then sign-in, first-run or the main pane, then the footer.
  Content stops at 560 px and stays left-aligned; below 400 px the layout is compact (c:Fmc.Compact).
-->
<UserControl x:Class="Formcraft.Shell.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Formcraft.Shell.Controls"
             xmlns:parts="clr-namespace:Formcraft.Shell.Views.Parts"
             xmlns:local="clr-namespace:Formcraft.Shell.Views"
             MinWidth="320"
             FontFamily="{DynamicResource Fmc.Font}" FontSize="12.5"
             Background="{DynamicResource Fmc.SurfaceBrush}" Foreground="{DynamicResource Fmc.InkBrush}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Theme/FmcColors.Light.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Theme/FmcTheme.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Views/SettingTemplates.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Wider than 560 px: the content stops and stays left-aligned (board core/ResponsivePane) -->
      <ColumnDefinition Width="*" MaxWidth="560"/>
    </Grid.ColumnDefinitions>

  <DockPanel x:Name="Pane" LastChildFill="True">

    <parts:HeaderBar DockPanel.Dock="Top"/>
    <Border DockPanel.Dock="Top" Height="2" Background="{DynamicResource Fmc.OrangeBrush}"/>

    <parts:FooterBar DockPanel.Dock="Bottom"/>

    <Grid>

      <!-- 1. Sign in (board account/PaneSignIn) -->
      <local:SignInView DataContext="{Binding SignIn}"
                        Visibility="{Binding DataContext.IsSignIn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}"/>

      <!-- 2. First-run setup (board account/PaneWelcome) -->
      <local:WelcomeView DataContext="{Binding Welcome}"
                         Visibility="{Binding DataContext.IsWelcome, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}"/>

      <!-- 3. Main pane -->
      <DockPanel Visibility="{Binding IsMain, Converter={StaticResource Vis}}">

        <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="10,6,10,0" AutomationProperties.Name="Find a feature"
                 ToolTip="Find a feature or rule (Ctrl+K)" Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="OnSearchKeyDown">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource FmcSearchBox}">
              <Setter Property="c:Fmc.Placeholder" Value="Find a feature or rule… (Ctrl+K)"/>
              <Style.Triggers>
                <Trigger Property="c:Fmc.Compact" Value="True">
                  <Setter Property="c:Fmc.Placeholder" Value="Find…"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>

        <parts:GroupNav DockPanel.Dock="Top" Margin="0,2,0,0"/>
        <parts:QuickTools DockPanel.Dock="Top" Visibility="{Binding ShowQuickTools, Converter={StaticResource Vis}}"/>

        <!-- Document banner: which model, and what the live-model lock allows -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Fmc.DividerBrush}" BorderThickness="0,1" Padding="10,6,10,8">
          <c:FmcDocBanner Header="{Binding Document.Title}" Content="{Binding Document.LockText}" State="{Binding Document.State}"/>
        </Border>

        <!-- State banner (board account/PaneStates): one state at a time, with its next step -->
        <parts:StateBanner DockPanel.Dock="Top" DataContext="{Binding StateBanner}" Margin="10,8,10,0"
                           Visibility="{Binding DataContext.HasStateBanner, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}, Converter={StaticResource Vis}}"/>

        <Grid>
          <!-- Every part is off -->
          <StackPanel Margin="10" Visibility="{Binding ShowNoParts, Converter={StaticResource Vis}}">
            <TextBlock Text="Every part is off" Style="{StaticResource FmcText.GroupTitle}"/>
            <TextBlock Text="Turn parts back on in Settings, under each module's parts in the pane." Style="{StaticResource FmcText.Hint}"/>
          </StackPanel>

          <!-- Section body: locked state or placeholder until the feature is built -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Visibility="{Binding DataContext.ShowSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}" DataContext="{Binding Body}">
            <StackPanel Margin="10">
              <TextBlock Text="{Binding Title}" Style="{StaticResource FmcText.GroupTitle}"/>
              <local:LockedView Visibility="{Binding Locked, Converter={StaticResource Vis}}"/>
              <TextBlock Text="{Binding PlaceholderText}" Style="{StaticResource FmcText.Hint}"/>
            </StackPanel>
          </ScrollViewer>

          <!-- A section with its own page (Setup › Families, Setup › Templates…) instead of the placeholder -->
          <ContentControl Content="{Binding DataContext.HostContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Visibility="{Binding DataContext.ShowHostSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}"
                          Focusable="False"/>

          <!-- Connect (board core/PaneConnect, U12) -->
          <local:ConnectView DataContext="{Binding Connect}"
                             Visibility="{Binding DataContext.IsConnectOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}"/>

          <!-- Settings: Account, General and a tab per licensed module (U06) -->
          <local:SettingsView Visibility="{Binding SettingsOpen, Converter={StaticResource Vis}}"/>

          <!-- Admin (U07): admins only -->
          <local:AdminView DataContext="{Binding Admin}"
                           Visibility="{Binding DataContext.IsAdminOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}"/>

          <!-- Search results, in place of the body while there is a query (board core/UI_Palette) -->
          <parts:SearchView DataContext="{Binding Search}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"/>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>

  <!-- Dialog host: one dialog at a time, over the whole pane -->
  <c:FmcDialog Header="{Binding Dialog.Title}" IsOpen="{Binding IsDialogOpen}">
    <StackPanel DataContext="{Binding Dialog}">
      <Border Background="{DynamicResource Fmc.Chip.WarnBg}" CornerRadius="4" Padding="8,6" Visibility="{Binding IsNote, Converter={StaticResource Vis}}">
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Fmc.Chip.WarnFg}" FontSize="11.5" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="{Binding Message}" Style="{StaticResource FmcText.Hint}" FontSize="11.5" Visibility="{Binding ShowText, Converter={StaticResource Vis}}" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Visibility="{Binding HasItems, Converter={StaticResource Vis}}"/>
      <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource Fmc.CriticalBrush}" TextWrapping="Wrap"
                 Visibility="{Binding HasItemsError, Converter={StaticResource Vis}}"/>
      <StackPanel Visibility="{Binding HasInput, Converter={StaticResource Vis}}">
        <TextBlock Text="{Binding InputLabel}" Style="{StaticResource FmcText.Label}"/>
        <TextBox x:Name="DialogInput" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FmcTextBox}"
                 FontFamily="{StaticResource Fmc.Mono}" AutomationProperties.Name="{Binding InputLabel}" c:Fmc.Invalid="{Binding HasError}"/>
        <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource Fmc.CriticalBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource Vis}}"/>
      </StackPanel>
    </StackPanel>
    <c:FmcDialog.Footer>
      <StackPanel Orientation="Horizontal">
        <Button Content="Cancel" Style="{StaticResource FmcButton.Secondary}" Command="{Binding Dialog.CancelCommand}" Margin="0,0,6,0"/>
        <Button Content="{Binding Dialog.PrimaryText}" Style="{StaticResource FmcButton.Primary}" Command="{Binding Dialog.ConfirmCommand}"/>
      </StackPanel>
    </c:FmcDialog.Footer>
  </c:FmcDialog>
  </Grid>
</UserControl>
