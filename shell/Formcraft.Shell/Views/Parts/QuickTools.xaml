<!-- Quick tools strip: Touch, Section Box, View range, Tag Tidy, one click away. Shown only when Flow is licensed. -->
<UserControl x:Class="Formcraft.Shell.Views.Parts.QuickTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="10,0,10,6" LastChildFill="False">
    <TextBlock Text="Quick tools" FontSize="10.5" Foreground="{DynamicResource Fmc.MutedBrush}" VerticalAlignment="Center"/>
    <ContentControl DockPanel.Dock="Right" Content="Flow" Style="{DynamicResource FmcTag}"
                    Background="{DynamicResource Fmc.Chip.WarnBg}" Foreground="{DynamicResource Fmc.Chip.WarnFg}"/>
    <ItemsControl ItemsSource="{Binding QuickTools}" Focusable="False" AutomationProperties.Name="Quick tools">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Content="{Binding}" Style="{DynamicResource FmcButton.Pill}" Margin="4,0,0,0"
                  Command="{Binding DataContext.QuickToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
