<!--
  State banner (board account/PaneStates): what happened, what still works, and the one next step. One state at a time.
  DataContext: StateBannerInfo.
-->
<UserControl x:Class="Formcraft.Shell.Views.Parts.StateBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
  </UserControl.Resources>
  <Border CornerRadius="5" Padding="8,6" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Says}">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Fmc.Chip.InfoBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fmc.Chip.InfoFg}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Kind}" Value="Warn">
            <Setter Property="Background" Value="{DynamicResource Fmc.Chip.WarnBg}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Fmc.Chip.WarnFg}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="Bad">
            <Setter Property="Background" Value="{DynamicResource Fmc.Chip.BadBg}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Fmc.Chip.BadFg}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="Grey">
            <Setter Property="Background" Value="{DynamicResource Fmc.Chip.GreyBg}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Fmc.Chip.GreyFg}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="{Binding Action}" Command="{Binding Command}" Style="{DynamicResource FmcButton.Secondary}"
              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding HasAction, Converter={StaticResource Vis}}"/>
      <Path DockPanel.Dock="Left" Width="12" Height="12" Stretch="Uniform" Margin="0,2,7,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"
            Data="M8,1 A7,7 0 1 1 1,8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
            Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
        <Path.RenderTransform><RotateTransform x:Name="Spin"/></Path.RenderTransform>
        <Path.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Path.Triggers>
      </Path>
      <StackPanel>
        <TextBlock Text="{Binding Says}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding StillWorks}" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
