<!--
  Footer: the open section's buttons on the left (wrapping), the status line on the right.
  Compact: the status line moves under the buttons.
-->
<UserControl x:Class="Formcraft.Shell.Views.Parts.FooterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Formcraft.Shell.Controls">
  <Border Background="{DynamicResource Fmc.FooterBrush}" BorderBrush="{DynamicResource Fmc.DividerBrush}" BorderThickness="0,1,0,0" Padding="8,5">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ItemsControl ItemsSource="{Binding FooterActions}" Focusable="False" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button x:Name="Action" Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,4,0" c:Fmc.StyleKey="FmcButton.Secondary"/>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Primary}" Value="True">
                <Setter TargetName="Action" Property="c:Fmc.StyleKey" Value="FmcButton.Primary"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Ai}" Value="True">
                <Setter TargetName="Action" Property="c:Fmc.StyleKey" Value="FmcButton.Ai"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Fmc.MutedBrush}" VerticalAlignment="Center"
                 TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Style.Triggers>
              <Trigger Property="c:Fmc.Compact" Value="True">
                <Setter Property="Grid.Column" Value="0"/>
                <Setter Property="Grid.ColumnSpan" Value="2"/>
                <Setter Property="Grid.Row" Value="1"/>
                <Setter Property="TextAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </Border>
</UserControl>
