<!--
  AI approvals (owner 26 Oct): its own page for everyone, opened from the header's "AI: N waiting" badge. The rows use
  the same templates as Settings (SettingTemplates.xaml). DataContext: ApprovalsViewModel.
-->
<UserControl x:Class="Formcraft.Shell.Views.ApprovalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Formcraft.Shell;component/Views/SettingTemplates.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
    <StackPanel>
      <Border Style="{DynamicResource FmcGroup}">
        <StackPanel>
          <TextBlock Text="AI APPROVALS" Style="{DynamicResource FmcText.Section}"/>
          <TextBlock Text="Changes AI prepared for your model. Approve runs a change now; Reject drops it. Nothing changes without your yes."
                     Style="{DynamicResource FmcText.Hint}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource FmcGroup}">
              <StackPanel>
                <TextBlock Text="{Binding Title, Converter={StaticResource Upper}}" Style="{DynamicResource FmcText.Section}"/>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
