<!--
  Formcraft colours, dark theme. Same keys as FmcColors.Light.xaml (tests/shell checks it).
  ThemeService swaps this dictionary when the theme changes, so views and styles read these keys
  with DynamicResource. Change a value here, never in a view.
  Dark values sit with Revit's own dark panels; brand colours stay as accents.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <sys:String x:Key="Fmc.ThemeName">Dark</sys:String>

  <Color x:Key="Fmc.Navy">#1B2532</Color>         <!-- Brand navy: AI tag text, logo -->
  <Color x:Key="Fmc.Orange">#FFAE61</Color>       <!-- Brand line under the header, AI tag -->
  <Color x:Key="Fmc.Primary">#4A6B96</Color>      <!-- Primary buttons, selected section, switch on -->
  <Color x:Key="Fmc.OnPrimary">#FFFFFF</Color>    <!-- Text on Primary -->
  <Color x:Key="Fmc.Accent">#9DBBE3</Color>       <!-- Selected group underline, focus ring, active borders -->
  <Color x:Key="Fmc.Ink">#F1F3F5</Color>          <!-- Body text -->
  <Color x:Key="Fmc.Muted">#B9C0CB</Color>        <!-- Secondary text, hints -->
  <Color x:Key="Fmc.Tab">#C7CDD6</Color>          <!-- Group tab text -->
  <Color x:Key="Fmc.SectionInk">#DDE1E6</Color>   <!-- Section button text, close icon -->
  <Color x:Key="Fmc.Surface">#3B4453</Color>      <!-- Pane body, cards, secondary buttons -->
  <Color x:Key="Fmc.Field">#2C333F</Color>        <!-- Inputs -->
  <Color x:Key="Fmc.Header">#313845</Color>       <!-- Pane header, table head, read-only fields -->
  <Color x:Key="Fmc.Footer">#353C49</Color>       <!-- Footer, dialog footer -->
  <Color x:Key="Fmc.Line">#5A6477</Color>         <!-- Borders, inputs -->
  <Color x:Key="Fmc.Divider">#4A5363</Color>      <!-- Rules between rows and groups -->
  <Color x:Key="Fmc.Hover">#434C5D</Color>        <!-- Row and item hover, pressed -->
  <Color x:Key="Fmc.Selected">#4A5A73</Color>     <!-- Selected table row -->
  <Color x:Key="Fmc.Track">#2C333F</Color>        <!-- Segmented control track -->
  <Color x:Key="Fmc.ToggleOff">#7A8494</Color>    <!-- Switch track when off -->
  <Color x:Key="Fmc.Backdrop">#262B34</Color>     <!-- Behind the pane (preview window) -->
  <Color x:Key="Fmc.Scrim">#99000000</Color>      <!-- Dialog overlay -->
  <Color x:Key="Fmc.Shadow">#000000</Color>       <!-- Dialog shadow -->
  <Color x:Key="Fmc.Flow">#7FC7BE</Color>         <!-- Flow accent -->
  <Color x:Key="Fmc.Model">#6FA8FF</Color>        <!-- Model accent -->
  <Color x:Key="Fmc.Build">#E8C27A</Color>        <!-- Build accent -->
  <Color x:Key="Fmc.Good">#5CC27A</Color>         <!-- OK, connected -->
  <Color x:Key="Fmc.Warning">#F0B930</Color>      <!-- Needs attention -->
  <Color x:Key="Fmc.Critical">#F89C93</Color>     <!-- Refused, error -->

  <SolidColorBrush x:Key="Fmc.NavyBrush" Color="{StaticResource Fmc.Navy}"/>
  <SolidColorBrush x:Key="Fmc.OrangeBrush" Color="{StaticResource Fmc.Orange}"/>
  <SolidColorBrush x:Key="Fmc.PrimaryBrush" Color="{StaticResource Fmc.Primary}"/>
  <SolidColorBrush x:Key="Fmc.OnPrimaryBrush" Color="{StaticResource Fmc.OnPrimary}"/>
  <SolidColorBrush x:Key="Fmc.AccentBrush" Color="{StaticResource Fmc.Accent}"/>
  <SolidColorBrush x:Key="Fmc.InkBrush" Color="{StaticResource Fmc.Ink}"/>
  <SolidColorBrush x:Key="Fmc.MutedBrush" Color="{StaticResource Fmc.Muted}"/>
  <SolidColorBrush x:Key="Fmc.TabBrush" Color="{StaticResource Fmc.Tab}"/>
  <SolidColorBrush x:Key="Fmc.SectionInkBrush" Color="{StaticResource Fmc.SectionInk}"/>
  <SolidColorBrush x:Key="Fmc.SurfaceBrush" Color="{StaticResource Fmc.Surface}"/>
  <SolidColorBrush x:Key="Fmc.FieldBrush" Color="{StaticResource Fmc.Field}"/>
  <SolidColorBrush x:Key="Fmc.HeaderBrush" Color="{StaticResource Fmc.Header}"/>
  <SolidColorBrush x:Key="Fmc.FooterBrush" Color="{StaticResource Fmc.Footer}"/>
  <SolidColorBrush x:Key="Fmc.LineBrush" Color="{StaticResource Fmc.Line}"/>
  <SolidColorBrush x:Key="Fmc.DividerBrush" Color="{StaticResource Fmc.Divider}"/>
  <SolidColorBrush x:Key="Fmc.HoverBrush" Color="{StaticResource Fmc.Hover}"/>
  <SolidColorBrush x:Key="Fmc.SelectedBrush" Color="{StaticResource Fmc.Selected}"/>
  <SolidColorBrush x:Key="Fmc.TrackBrush" Color="{StaticResource Fmc.Track}"/>
  <SolidColorBrush x:Key="Fmc.ToggleOffBrush" Color="{StaticResource Fmc.ToggleOff}"/>
  <SolidColorBrush x:Key="Fmc.BackdropBrush" Color="{StaticResource Fmc.Backdrop}"/>
  <SolidColorBrush x:Key="Fmc.ScrimBrush" Color="{StaticResource Fmc.Scrim}"/>
  <SolidColorBrush x:Key="Fmc.ShadowBrush" Color="{StaticResource Fmc.Shadow}"/>
  <SolidColorBrush x:Key="Fmc.FlowBrush" Color="{StaticResource Fmc.Flow}"/>
  <SolidColorBrush x:Key="Fmc.ModelBrush" Color="{StaticResource Fmc.Model}"/>
  <SolidColorBrush x:Key="Fmc.BuildBrush" Color="{StaticResource Fmc.Build}"/>
  <SolidColorBrush x:Key="Fmc.GoodBrush" Color="{StaticResource Fmc.Good}"/>
  <SolidColorBrush x:Key="Fmc.WarningBrush" Color="{StaticResource Fmc.Warning}"/>
  <SolidColorBrush x:Key="Fmc.CriticalBrush" Color="{StaticResource Fmc.Critical}"/>

  <!-- Chip states: background / foreground -->
  <SolidColorBrush x:Key="Fmc.Chip.GoodBg" Color="#203B2A"/>
  <SolidColorBrush x:Key="Fmc.Chip.GoodFg" Color="#A6E3B6"/>
  <SolidColorBrush x:Key="Fmc.Chip.WarnBg" Color="#3F3214"/>
  <SolidColorBrush x:Key="Fmc.Chip.WarnFg" Color="#F6D58A"/>
  <SolidColorBrush x:Key="Fmc.Chip.BadBg" Color="#4A2323"/>
  <SolidColorBrush x:Key="Fmc.Chip.BadFg" Color="#F8B4AD"/>
  <SolidColorBrush x:Key="Fmc.Chip.InfoBg" Color="#1C3D39"/>
  <SolidColorBrush x:Key="Fmc.Chip.InfoFg" Color="#A5DDD4"/>
  <SolidColorBrush x:Key="Fmc.Chip.GreyBg" Color="#4E5869"/>
  <SolidColorBrush x:Key="Fmc.Chip.GreyFg" Color="#E1E5EA"/>

</ResourceDictionary>
