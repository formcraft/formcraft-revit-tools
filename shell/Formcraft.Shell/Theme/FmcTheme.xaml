<!--
  Formcraft theme: sizes, type and every control style of the UI kit (see docs/UI_KIT.md and the
  "Build-ready UI kit" board on the central canvas). Colours live in FmcColors.Light.xaml / FmcColors.Dark.xaml;
  styles read them with DynamicResource so ThemeService can switch Light and Dark while the pane is open.
  Change a value here, never in a view.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:c="clr-namespace:Formcraft.Shell.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="FmcIcons.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Type: IBM Plex embedded in this assembly (resources/fonts), Segoe UI / Consolas if it can't load -->
  <FontFamily x:Key="Fmc.Font">pack://application:,,,/Formcraft.Shell;component/Fonts/#IBM Plex Sans, Segoe UI</FontFamily>
  <FontFamily x:Key="Fmc.Mono">pack://application:,,,/Formcraft.Shell;component/Fonts/#IBM Plex Mono, Consolas</FontFamily>
  <sys:Double x:Key="Fmc.Size.Header">13</sys:Double>
  <sys:Double x:Key="Fmc.Size.Body">12.5</sys:Double>
  <sys:Double x:Key="Fmc.Size.Control">11.5</sys:Double>
  <sys:Double x:Key="Fmc.Size.Hint">10.5</sys:Double>

  <!-- Radius: 3 buttons · 4 inputs · 5 nav · 8 pane and dialogs -->
  <CornerRadius x:Key="Fmc.Radius.Button">3</CornerRadius>
  <CornerRadius x:Key="Fmc.Radius.Input">4</CornerRadius>
  <CornerRadius x:Key="Fmc.Radius.Nav">5</CornerRadius>
  <CornerRadius x:Key="Fmc.Radius.Dialog">8</CornerRadius>

  <c:UpperCaseConverter x:Key="Fmc.Upper"/>

  <!-- Keyboard focus: one ring for every control -->
  <Style x:Key="Fmc.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" RadiusX="4" RadiusY="4" StrokeThickness="2" SnapsToDevicePixels="True"
                     Stroke="{DynamicResource Fmc.AccentBrush}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons: rest, hover, pressed, disabled, busy (Fmc.Busy) -->
  <Style x:Key="FmcButton.Secondary" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,2"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Fmc.Radius.Button}"/>
            <Border x:Name="Press" Background="{DynamicResource Fmc.InkBrush}" CornerRadius="{StaticResource Fmc.Radius.Button}" Opacity="0"/>
            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="Spinner" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                  Data="M8,1 A7,7 0 1 1 1,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><RotateTransform x:Name="Spin" Angle="0"/></Path.RenderTransform>
            </Path>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Press" Property="Opacity" Value="0.10"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
            <Trigger Property="c:Fmc.Busy" Value="True">
              <Setter TargetName="Content" Property="Opacity" Value="0.25"/>
              <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
              <Setter Property="IsHitTestVisible" Value="False"/>
              <Setter Property="Cursor" Value="Wait"/>
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Spinning">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360"
                                     Duration="0:0:0.9" RepeatBehavior="Forever"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Spinning"/>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FmcButton.Primary" TargetType="Button" BasedOn="{StaticResource FmcButton.Secondary}">
    <Setter Property="Foreground" Value="{DynamicResource Fmc.OnPrimaryBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.PrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.PrimaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- AI button: secondary with the orange AI tag. Fmc.NeedsKey: no AI key, so it can't run -->
  <Style x:Key="FmcButton.Ai" TargetType="Button" BasedOn="{StaticResource FmcButton.Secondary}">
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <ContentPresenter Content="{Binding}" VerticalAlignment="Center"/>
            <Border x:Name="Tag" Margin="4,0,0,0" Padding="4,0" CornerRadius="3" VerticalAlignment="Center"
                    Background="{DynamicResource Fmc.OrangeBrush}">
              <TextBlock Text="AI" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Fmc.NavyBrush}"/>
            </Border>
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="c:Fmc.NeedsKey" Value="True">
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="ToolTip" Value="Needs an AI key. Your admin adds one in Admin › AI."/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Icon-only button (close, help): label it with AutomationProperties.Name -->
  <Style x:Key="FmcButton.Icon" TargetType="Button">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.SectionInkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Fmc.Radius.Input}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Switch: on, off, locked (Fmc.Locked: padlock, set by a team rule or by the user only) -->
  <Style x:Key="FmcToggle" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="40" Height="22" VerticalAlignment="Center">
              <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource Fmc.ToggleOffBrush}"/>
              <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Fmc.OnPrimaryBrush}"/>
            </Grid>
            <Path x:Name="Padlock" Width="12" Height="12" Margin="6,0,0,0" Stretch="Uniform" VerticalAlignment="Center" Visibility="Collapsed"
                  Data="M5,7 V5 A3,3 0 0 1 11,5 V7 M3,7 H13 V15 H3 Z" Stroke="{DynamicResource Fmc.MutedBrush}" StrokeThickness="1.6"/>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
            </Trigger>
            <Trigger Property="c:Fmc.Locked" Value="True">
              <Setter TargetName="Padlock" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Track" Property="Opacity" Value="0.6"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False"/>
                <Condition Property="c:Fmc.Locked" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter Property="Opacity" Value="0.5"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="c:Fmc.Locked" Value="True">
        <Setter Property="IsEnabled" Value="False"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Segmented: a ListBox, one item selected ("Follow Revit | Light | Dark") -->
  <Style x:Key="FmcSegmented.Item" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Fmc.Radius.Input}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.SurfaceBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FmcSegmented" TargetType="ListBox">
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource FmcSegmented.Item}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{DynamicResource Fmc.TrackBrush}" CornerRadius="{StaticResource Fmc.Radius.Nav}" Padding="2">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chips: good, warning, critical, info, neutral -->
  <Style x:Key="FmcChip" TargetType="ContentControl">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FmcChip.Good" TargetType="ContentControl" BasedOn="{StaticResource FmcChip}">
    <Setter Property="Background" Value="{DynamicResource Fmc.Chip.GoodBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.Chip.GoodFg}"/>
  </Style>
  <Style x:Key="FmcChip.Warn" TargetType="ContentControl" BasedOn="{StaticResource FmcChip}">
    <Setter Property="Background" Value="{DynamicResource Fmc.Chip.WarnBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.Chip.WarnFg}"/>
  </Style>
  <Style x:Key="FmcChip.Bad" TargetType="ContentControl" BasedOn="{StaticResource FmcChip}">
    <Setter Property="Background" Value="{DynamicResource Fmc.Chip.BadBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.Chip.BadFg}"/>
  </Style>
  <Style x:Key="FmcChip.Info" TargetType="ContentControl" BasedOn="{StaticResource FmcChip}">
    <Setter Property="Background" Value="{DynamicResource Fmc.Chip.InfoBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.Chip.InfoFg}"/>
  </Style>
  <Style x:Key="FmcChip.Grey" TargetType="ContentControl" BasedOn="{StaticResource FmcChip}">
    <Setter Property="Background" Value="{DynamicResource Fmc.Chip.GreyBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.Chip.GreyFg}"/>
  </Style>

  <!-- Check line: tick, label, status chip on the right -->
  <Style x:Key="FmcCheckRow" TargetType="c:FmcCheckRow">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:FmcCheckRow">
          <DockPanel Background="Transparent" LastChildFill="True">
            <Border x:Name="Box" DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                    BorderThickness="1" BorderBrush="{DynamicResource Fmc.LineBrush}" Background="{DynamicResource Fmc.FieldBrush}">
              <Path x:Name="Tick" Data="M2.5,6.5 L5,9 L9.5,3.5" Stroke="{DynamicResource Fmc.OnPrimaryBrush}" StrokeThickness="1.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Margin="0.5,0,0,0"/>
            </Border>
            <Border x:Name="Chip" DockPanel.Dock="Right" CornerRadius="9" Padding="7,1" Margin="7,0,0,0" VerticalAlignment="Center"
                    Background="{DynamicResource Fmc.Chip.GoodBg}">
              <TextBlock x:Name="ChipText" Text="{TemplateBinding Status}" FontSize="{StaticResource Fmc.Size.Hint}"
                         Foreground="{DynamicResource Fmc.Chip.GoodFg}"/>
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
            <Trigger Property="Status" Value="">
              <Setter TargetName="Chip" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="StatusKind" Value="Warn">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Fmc.Chip.WarnBg}"/>
              <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Fmc.Chip.WarnFg}"/>
            </Trigger>
            <Trigger Property="StatusKind" Value="Bad">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Fmc.Chip.BadBg}"/>
              <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Fmc.Chip.BadFg}"/>
            </Trigger>
            <Trigger Property="StatusKind" Value="Info">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Fmc.Chip.InfoBg}"/>
              <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Fmc.Chip.InfoFg}"/>
            </Trigger>
            <Trigger Property="StatusKind" Value="Grey">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Fmc.Chip.GreyBg}"/>
              <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Fmc.Chip.GreyFg}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="c:FmcCheckRow" BasedOn="{StaticResource FmcCheckRow}"/>

  <!-- Input: empty (Fmc.Placeholder), filled, invalid (Fmc.Invalid), read-only -->
  <Style x:Key="FmcTextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.FieldBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.LineBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Fmc.Radius.Input}">
            <Grid>
              <TextBlock x:Name="Placeholder" Text="{TemplateBinding c:Fmc.Placeholder}" Foreground="{DynamicResource Fmc.MutedBrush}"
                         Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.MutedBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
              <Setter TargetName="PART_ContentHost" Property="Margin" Value="5,0"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.HeaderBrush}"/>
            </Trigger>
            <Trigger Property="c:Fmc.Invalid" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.CriticalBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A value the person can read and copy but not change (paths, codes, IDs) -->
  <Style x:Key="FmcReadOnly" TargetType="TextBox" BasedOn="{StaticResource FmcTextBox}">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.DividerBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Mono}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
  </Style>

  <Style x:Key="FmcPasswordBox" TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.FieldBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.LineBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Fmc.Radius.Input}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.MutedBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
              <Setter TargetName="PART_ContentHost" Property="Margin" Value="5,0"/>
            </Trigger>
            <Trigger Property="c:Fmc.Invalid" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.CriticalBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Table: a DataGrid with the board's head row, rules between rows, hover and selection -->
  <Style x:Key="FmcTable.Header" TargetType="DataGridColumnHeader">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.MutedBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.HeaderBrush}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Fmc.Upper}}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FmcTable.Cell" TargetType="DataGridCell">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FmcTable.Row" TargetType="DataGridRow">
    <Setter Property="Background" Value="{DynamicResource Fmc.SurfaceBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Fmc.HoverBrush}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Fmc.SelectedBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FmcTable" TargetType="DataGrid">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.SurfaceBrush}"/>
    <Setter Property="RowBackground" Value="{DynamicResource Fmc.SurfaceBrush}"/>
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource Fmc.SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.DividerBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Fmc.DividerBrush}"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource FmcTable.Header}"/>
    <Setter Property="CellStyle" Value="{StaticResource FmcTable.Cell}"/>
    <Setter Property="RowStyle" Value="{StaticResource FmcTable.Row}"/>
  </Style>

  <!-- Document banner: setup open (green), shared (amber), live (red) -->
  <Style x:Key="FmcDocBanner" TargetType="c:FmcDocBanner">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.Chip.GoodBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.Chip.GoodFg}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:FmcDocBanner">
          <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Fmc.Radius.Nav}" Padding="8,6">
            <StackPanel TextElement.Foreground="{TemplateBinding Foreground}">
              <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="Detail" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Compact" Value="True">
              <Setter TargetName="Detail" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Box" Property="Padding" Value="8,3"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="State" Value="Shared">
        <Setter Property="Background" Value="{DynamicResource Fmc.Chip.WarnBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fmc.Chip.WarnFg}"/>
      </Trigger>
      <Trigger Property="State" Value="Live">
        <Setter Property="Background" Value="{DynamicResource Fmc.Chip.BadBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fmc.Chip.BadFg}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="c:FmcDocBanner" BasedOn="{StaticResource FmcDocBanner}"/>

  <!-- Dialog over the pane: scrim, card with title bar, orange line, body and footer buttons -->
  <Style x:Key="FmcDialog" TargetType="c:FmcDialog">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:FmcDialog">
          <Grid>
            <Border Background="{DynamicResource Fmc.ScrimBrush}"/>
            <Border VerticalAlignment="Top" Margin="12,64,12,12" CornerRadius="{StaticResource Fmc.Radius.Dialog}"
                    Background="{DynamicResource Fmc.SurfaceBrush}"
                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
              <Border.Effect>
                <DropShadowEffect Color="{DynamicResource Fmc.Shadow}" BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.3"/>
              </Border.Effect>
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Fmc.HeaderBrush}" CornerRadius="8,8,0,0" Padding="12,8,10,8">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FmcButton.Icon}" Command="{x:Static c:FmcDialog.CloseCommand}"
                            AutomationProperties.Name="Close" ToolTip="Close (Esc)">
                      <Path Data="M6,6 L18,18 M18,6 L6,18" Width="14" Height="14" Stretch="Uniform" StrokeThickness="2.2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Fmc.SectionInkBrush}"/>
                    </Button>
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                      TextElement.FontWeight="SemiBold" TextElement.FontSize="{StaticResource Fmc.Size.Header}"/>
                  </DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" Height="2" Background="{DynamicResource Fmc.OrangeBrush}"/>
                <Border x:Name="FooterBar" DockPanel.Dock="Bottom" Background="{DynamicResource Fmc.FooterBrush}" CornerRadius="0,0,8,8"
                        BorderBrush="{DynamicResource Fmc.DividerBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                  <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Right"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" PanningMode="VerticalOnly">
                  <ContentPresenter Margin="12"/>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Footer" Value="{x:Null}">
              <Setter TargetName="FooterBar" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsOpen" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="c:FmcDialog" BasedOn="{StaticResource FmcDialog}"/>

  <!-- Line icon (Theme/FmcIcons.xaml), drawn in the current Foreground -->
  <Style TargetType="c:FmcIcon">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:FmcIcon">
          <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}" Stretch="Uniform">
            <Canvas Width="24" Height="24">
              <Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Header buttons (Settings, Admin): pressed while that page is open -->
  <Style x:Key="FmcToggleButton" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Fmc.Radius.Button}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource Fmc.OnPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Round status chip button (header "Connected"): pressed while Connect is open -->
  <Style x:Key="FmcStatusChip" TargetType="ToggleButton" BasedOn="{StaticResource FmcToggleButton}">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource Fmc.OnPrimaryBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Field label above a control (boards: 12 px, semibold) -->
  <Style x:Key="FmcText.Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>

  <!-- Heading of a block in a pane (boards: 11 px capitals, muted). Write the text in capitals. -->
  <Style x:Key="FmcText.Section" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.MutedBrush}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <!-- Text link (Forgot password): accent, underlined on hover -->
  <Style x:Key="FmcButton.Link" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="0,2">
            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" VerticalAlignment="Center" TextDecorations="Underline"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A step in a step bar or a segment outside a ListBox: the current one is raised, done ones keep their tick -->
  <Style x:Key="FmcSegmentButton" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.TabBrush}"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Fmc.Radius.Input}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.SurfaceBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Drop-down: a 28 px field with a chevron; the list opens below, themed -->
  <Style x:Key="FmcComboBox.Item" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.SelectedBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FmcComboBox" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.FieldBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.LineBrush}"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource FmcComboBox.Item}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderThickness="1" CornerRadius="{StaticResource Fmc.Radius.Input}">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Data="M0,0 L4.5,4.5 L9,0"
                          Stroke="{DynamicResource Fmc.MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.MutedBrush}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="8,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Margin="0,2,0,6"
                      Background="{DynamicResource Fmc.SurfaceBrush}" BorderBrush="{DynamicResource Fmc.LineBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Fmc.Radius.Input}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chip switch ("Show these parts"): round, navy when on -->
  <Style x:Key="FmcChipToggle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.SectionInkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.LineBrush}"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="MinWidth" Value="36"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="13" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource Fmc.OnPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pill button (quick tools) -->
  <Style x:Key="FmcButton.Pill" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.LineBrush}"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Padding" Value="7,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"/>
            <Border x:Name="Press" Background="{DynamicResource Fmc.InkBrush}" CornerRadius="12" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Press" Property="Opacity" Value="0.10"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small tag: module tags (+Flow, +Model, +Build) and the quick tools' "Flow" -->
  <Style x:Key="FmcTag" TargetType="ContentControl">
    <Setter Property="FontSize" Value="9.5"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource Fmc.Chip.GreyBg}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="4,0">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Search box: magnifier, placeholder, 5 px radius -->
  <Style x:Key="FmcSearchBox" TargetType="TextBox" BasedOn="{StaticResource FmcTextBox}">
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
            <DockPanel Margin="8,0">
              <c:FmcIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Size="13" Foreground="{DynamicResource Fmc.MutedBrush}" Margin="0,0,6,0"/>
              <Grid>
                <TextBlock x:Name="Placeholder" Text="{TemplateBinding c:Fmc.Placeholder}" Foreground="{DynamicResource Fmc.MutedBrush}"
                           Padding="2,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
              </Grid>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.MutedBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Compact layout helpers (c:Fmc.Compact is set on the pane below 400 px) -->
  <Style x:Key="Fmc.HideWhenCompact" TargetType="FrameworkElement">
    <Style.Triggers>
      <Trigger Property="c:Fmc.Compact" Value="True">
        <Setter Property="Visibility" Value="Collapsed"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Navigation tab (group row) and section button -->
  <Style x:Key="FmcNav.Group" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.TabBrush}"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="c:Fmc.Compact" Value="True">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="3,0"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FmcNav.Section" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.SectionInkBrush}"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Fmc.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{DynamicResource Fmc.SurfaceBrush}" BorderBrush="{DynamicResource Fmc.LineBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Fmc.Radius.Nav}" Padding="6,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fmc.PrimaryBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource Fmc.OnPrimaryBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text -->
  <Style x:Key="FmcText.GroupTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style x:Key="FmcText.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.InkBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="FmcText.Hint" TargetType="TextBlock" BasedOn="{StaticResource FmcText.Body}">
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Hint}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fmc.MutedBrush}"/>
  </Style>

  <!-- A group card in the pane body -->
  <Style x:Key="FmcGroup" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Fmc.DividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="10,10,10,12"/>
  </Style>

  <!-- Scroll bars: slim, themed (implicit for everything inside the pane) -->
  <Style x:Key="Fmc.ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" CornerRadius="3" Background="{DynamicResource Fmc.LineBrush}" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.MutedBrush}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fmc.MutedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Fmc.ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Fmc.ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Fmc.ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource Fmc.ScrollThumb}"/></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Fmc.ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Fmc.ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource Fmc.ScrollThumb}"/></Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
