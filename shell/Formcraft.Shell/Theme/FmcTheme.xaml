<!--
  Formcraft theme: the single source of the UI kit tokens (see docs/UI_KIT.md and the
  "Build-ready UI kit" board on the central canvas). Change a value here, never in a view.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Colours -->
  <Color x:Key="Fmc.Navy">#1B2532</Color>
  <Color x:Key="Fmc.Orange">#FFAE61</Color>
  <Color x:Key="Fmc.Ink">#1A1D21</Color>
  <Color x:Key="Fmc.Muted">#5B6270</Color>
  <Color x:Key="Fmc.Line">#C9CED6</Color>
  <Color x:Key="Fmc.Header">#F1F3F5</Color>
  <Color x:Key="Fmc.Footer">#F8F9FA</Color>
  <Color x:Key="Fmc.White">#FFFFFF</Color>
  <Color x:Key="Fmc.Flow">#7FC7BE</Color>
  <Color x:Key="Fmc.Model">#6FA8FF</Color>
  <Color x:Key="Fmc.Build">#E8C27A</Color>
  <Color x:Key="Fmc.Good">#1E8E3E</Color>
  <Color x:Key="Fmc.Warning">#E0A100</Color>
  <Color x:Key="Fmc.Critical">#D93025</Color>

  <SolidColorBrush x:Key="Fmc.NavyBrush" Color="{StaticResource Fmc.Navy}"/>
  <SolidColorBrush x:Key="Fmc.OrangeBrush" Color="{StaticResource Fmc.Orange}"/>
  <SolidColorBrush x:Key="Fmc.InkBrush" Color="{StaticResource Fmc.Ink}"/>
  <SolidColorBrush x:Key="Fmc.MutedBrush" Color="{StaticResource Fmc.Muted}"/>
  <SolidColorBrush x:Key="Fmc.LineBrush" Color="{StaticResource Fmc.Line}"/>
  <SolidColorBrush x:Key="Fmc.HeaderBrush" Color="{StaticResource Fmc.Header}"/>
  <SolidColorBrush x:Key="Fmc.FooterBrush" Color="{StaticResource Fmc.Footer}"/>
  <SolidColorBrush x:Key="Fmc.WhiteBrush" Color="{StaticResource Fmc.White}"/>
  <SolidColorBrush x:Key="Fmc.GoodBrush" Color="{StaticResource Fmc.Good}"/>

  <!-- Chip states: background / foreground -->
  <SolidColorBrush x:Key="Fmc.Chip.GoodBg" Color="#E6F4EA"/>
  <SolidColorBrush x:Key="Fmc.Chip.GoodFg" Color="#1E6B34"/>
  <SolidColorBrush x:Key="Fmc.Chip.WarnBg" Color="#FFF4E0"/>
  <SolidColorBrush x:Key="Fmc.Chip.WarnFg" Color="#6B4100"/>
  <SolidColorBrush x:Key="Fmc.Chip.BadBg" Color="#FDECEA"/>
  <SolidColorBrush x:Key="Fmc.Chip.BadFg" Color="#A50E0E"/>
  <SolidColorBrush x:Key="Fmc.Chip.InfoBg" Color="#E3F2EF"/>
  <SolidColorBrush x:Key="Fmc.Chip.InfoFg" Color="#2C6B63"/>
  <SolidColorBrush x:Key="Fmc.Chip.GreyBg" Color="#EEF0F3"/>
  <SolidColorBrush x:Key="Fmc.Chip.GreyFg" Color="#4A515C"/>

  <!-- Type: IBM Plex Sans when installed, Segoe UI otherwise -->
  <FontFamily x:Key="Fmc.Font">IBM Plex Sans, Segoe UI</FontFamily>
  <FontFamily x:Key="Fmc.Mono">IBM Plex Mono, Consolas</FontFamily>
  <sys:Double x:Key="Fmc.Size.Header">13</sys:Double>
  <sys:Double x:Key="Fmc.Size.Body">12.5</sys:Double>
  <sys:Double x:Key="Fmc.Size.Control">11.5</sys:Double>
  <sys:Double x:Key="Fmc.Size.Hint">10.5</sys:Double>

  <!-- Buttons -->
  <Style x:Key="FmcButton.Secondary" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="Foreground" Value="{StaticResource Fmc.InkBrush}"/>
    <Setter Property="Background" Value="{StaticResource Fmc.WhiteBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Fmc.LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,2"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fmc.NavyBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fmc.NavyBrush}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FmcButton.Primary" TargetType="Button" BasedOn="{StaticResource FmcButton.Secondary}">
    <Setter Property="Foreground" Value="{StaticResource Fmc.WhiteBrush}"/>
    <Setter Property="Background" Value="{StaticResource Fmc.NavyBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Fmc.NavyBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Navigation tab (group row) and section button -->
  <Style x:Key="FmcNav.Group" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="#4A515C"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fmc.NavyBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Fmc.InkBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FmcNav.Section" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Control}"/>
    <Setter Property="Foreground" Value="#3B424D"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="{StaticResource Fmc.WhiteBrush}" BorderBrush="{StaticResource Fmc.LineBrush}" BorderThickness="1" CornerRadius="5" Padding="8,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fmc.NavyBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fmc.NavyBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Fmc.WhiteBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text -->
  <Style x:Key="FmcText.GroupTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Fmc.InkBrush}"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style x:Key="FmcText.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Body}"/>
    <Setter Property="Foreground" Value="{StaticResource Fmc.InkBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="FmcText.Hint" TargetType="TextBlock" BasedOn="{StaticResource FmcText.Body}">
    <Setter Property="FontSize" Value="{StaticResource Fmc.Size.Hint}"/>
    <Setter Property="Foreground" Value="{StaticResource Fmc.MutedBrush}"/>
  </Style>

  <!-- Input -->
  <Style x:Key="FmcTextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Fmc.Font}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="BorderBrush" Value="{StaticResource Fmc.LineBrush}"/>
  </Style>

  <!-- A group card in the pane body -->
  <Style x:Key="FmcGroup" TargetType="Border">
    <Setter Property="BorderBrush" Value="#E3E6EA"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="10,10,10,12"/>
  </Style>

</ResourceDictionary>
